<Window x:Class="LabApp.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabApp.Views"
        mc:Ignorable="d"
        Title="AddUserWindow"  Height="300" Width="500" FontSize="20" Foreground="#524" FontWeight="Bold" Background="#aee">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
            <TextBlock Text="Имя" Margin="0 0 0 2"/>
            <TextBlock Text="Фамилия" Margin="0 0 0 2"/>
            <TextBlock Text="Логин" Margin="0 0 0 2"/>
            <TextBlock Text="Почта" Margin="0 0 0 2"/>
            <TextBlock Text="Номер телефона" Margin="0 0 0 2"/>
            <TextBlock Text="Роль" Margin="0 0 0 2"/>
            <TextBlock Text="Пароль" Margin="0 0 0 2"/>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
            <TextBox x:Name="nameTextBox" Width="300"/>
            <TextBox x:Name="surnameTextBox" Width="300"/>
            <TextBox x:Name="loginTextBox" Width="300"/>
            <TextBox x:Name="emailTextBox" Width="300"/>
            <TextBox x:Name="phoneTextBox" Width="300"/>
            <TextBox x:Name="roleNameTextBox" Width="300"/>
            <PasswordBox x:Name="passPasswordBox" Width="300"/>
        </StackPanel>
        <Button x:Name="addUserButton" Grid.Row="7" Content="Добавить" Click="addUserButton_Click"/>
    </Grid>
</Window>
