<Window x:Class="LabApp.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabApp.Views"
        mc:Ignorable="d"
        Title="AddUserWindow"  Height="300" Width="500" FontSize="20" Foreground="#524" FontWeight="Bold" Background="#aee">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
            <TextBlock Text="Имя"/>
            <TextBlock Text="Фамилия"/>
            <TextBlock Text="Логин"/>
            <TextBlock Text="Почта"/>
            <TextBlock Text="Номер телефона"/>
            <TextBlock Text="Роль"/>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Left">
            <TextBox x:Name="nameTextBox" Width="200" Grid.Row="0" Grid.Column="1"/>
            <TextBox x:Name="surnameTextBox" Width="200" Grid.Row="1" Grid.Column="1"/>
            <TextBox x:Name="loginTextBox" Width="200" Grid.Row="2" Grid.Column="1"/>
            <TextBox x:Name="emailTextBox" Width="200" Grid.Row="3" Grid.Column="1"/>
            <TextBox x:Name="phoneTextBox" Width="200" Grid.Row="4" Grid.Column="1"/>
            <TextBox x:Name="roleNameTextBox" Width="200" Grid.Row="5" Grid.Column="1"/>
        </StackPanel>
        <Button x:Name="updateUserButton" Grid.Row="7" Content="Изменить" Click="updateUserButton_Click"/>
    </Grid>
</Window>
