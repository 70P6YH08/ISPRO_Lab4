<Window x:Class="LabApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="Поиск" Width="50" Grid.Column="0" HorizontalAlignment="Left"/>
            <TextBox x:Name="searchFieldTextBox" Width="200" Grid.Column="1"
                 HorizontalAlignment="Left" TextChanged="searchFieldTextBox_TextChanged"/>
        </DockPanel>

        <DataGrid x:Name="usersListDataGrid" SelectedItem="{Binding SelectedUser}"
          Grid.ColumnSpan="2" Grid.Row="1" Margin="0 10 0 10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}"/>
                <DataGridTextColumn Header="Почта" Binding="{Binding Email}"/>
                <DataGridTextColumn Header="Номер телефона" Binding="{Binding PhoneNumber}"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role.Name}"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 0 0 10">
            <Button x:Name="nextPageButton" Content="&lt;" Width="20" Margin="0 0 5 0" Click="nextPageButton_Click"/>
            <Button x:Name="prevPageButton" Content="&gt;" Width="20" Click="prevPageButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
