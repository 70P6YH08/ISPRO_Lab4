<Window x:Class="LabApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" FontSize="20" Foreground="#524" FontWeight="Bold" Background="#aee">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="Поиск" Width="100" Grid.Column="0" HorizontalAlignment="Left"/>
            <TextBox x:Name="searchFieldTextBox" Width="200" Grid.Column="1" Margin="0 0 50 0"
                 HorizontalAlignment="Left" TextChanged="searchFieldTextBox_TextChanged"/>
            <Button x:Name="addUserButton" Content="Добавление пользователя" Width="270" HorizontalAlignment="Right" Click="addUserButton_Click"/>
        </DockPanel>

        <DataGrid x:Name="usersListDataGrid" AutoGenerateColumns="False" SelectedItem="{Binding SelectedUser}"
          Grid.ColumnSpan="2" Grid.Row="1" Margin="0 10 0 10" BorderThickness="3" BorderBrush="#444" Background="#ced">
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="deleteUserMenuItem" Header="Удалить" Click="deleteUserMenuItem_Click"/>
                    <MenuItem x:Name="reviewUserMenuItem" Header="Просмотр" Click="reviewUserMenuItem_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}"/>
                <DataGridTextColumn Header="Номер телефона" Binding="{Binding PhoneNumber}"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 0 0 10">
            <Button x:Name="nextPageButton" Content="&lt;" Width="20" Margin="0 0 5 0" Click="prevPageButton_Click"/>
            <Button x:Name="prevPageButton" Content="&gt;" Width="20" Click="nextPageButton_Click"/>
        </DockPanel>
    </Grid>
</Window>
